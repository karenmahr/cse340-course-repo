<%- include('partials/header', { title: title }) %>

    <main>

        <h1>
            <%= project.title %>
        </h1>

        <p>
            <%= project.description %>
        </p>

        <p>
            <strong>Date:</strong>
            <%= project.date %>
        </p>

        <p>
            <strong>Location:</strong>
            <%= project.location %>
        </p>

        <p>
            <a href="/organization/<%= project.organization_id %>">
                <%= project.organization_name %>
            </a>
        </p>

        <% if (typeof isLoggedIn !=='undefined' && isLoggedIn) { %>
        
            <% if (typeof isVolunteer !=='undefined' && !isVolunteer) { %>

                <p>
                    <a href="/projects/<%= project.project_id %>/volunteer">
                        Volunteer for this project
                    </a>
                </p>

                <% } else { %>

                    <p>
                        <strong>You are volunteering for this project.</strong>
                    </p>

                    <p>
                        <a href="/projects/<%= project.project_id %>/unvolunteer">
                            Remove as Volunteer
                        </a>
                    </p>

                    <% } %>

                        <% } %>

    </main>

    <%- include('partials/footer') %>