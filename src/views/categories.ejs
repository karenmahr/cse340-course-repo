<%- include('partials/header') %>

    <main>
        <h1>Service Project Categories</h1>
        <ul>
            <% categories.forEach(category=> { %>
                <li>
                    <% if (user && user.role_name==='admin' ) { %>
                        <a href="/category/<%= category.categories_id %>">
                            <%= category.categories_name %>
                        </a>
                        <% } %>
                </li>
                <% }); %>
        </ul>

    </main>

    <%- include('partials/footer') %>