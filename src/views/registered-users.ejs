<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <h2>Registered Users</h2>
        <% users.forEach(user=> { %>

            <p>Name: <%= user.name %>
            </p>
            <p>Username: <%= user.email %>
            </p>
            <p>Role: <%= user.role_name %>
            </p>
            <% }); %>
    </main>

    <%- include('partials/footer') %>