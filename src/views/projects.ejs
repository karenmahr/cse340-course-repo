<%- include('partials/header') %>
    <main>
        <h1>Projects</h1>
        <h2>Upcoming Service Projects</h2>
        <ul>
            <% projects.forEach(service_project=> { %>
                <li>
                    <%= service_project.date.toISOString().split('T')[0] %>
                    <%= service_project.title %>
                    (<%= service_project.organization_name %>)
                </li>
                <% }); %>
        </ul>
    </main>
<%- include('partials/footer') %>
