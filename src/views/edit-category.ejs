<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <form action="/edit-category/<%= categoryDetails.categories_id %>" method="POST">
            <div class="form-group">
                <label for="categories_name">Update Category</label>
                <input 
                    type="text" 
                    id="categories_name" 
                    name="categories_name" 
                    value="<%= categoryDetails.categories_name %>" 
                    required 
                    maxlength="150" />
            </div>
            <a href="/edit-category/<%= categoryDetails.categories_id %>">Edit Category</a>

            <button type="submit">Update Category</button>
        </form>

    </main>
    <%- include('partials/footer') %>