<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <form action="/edit-project/<%= projectDetails.project_id %>" method="POST">
            <div class="form-group">
                <label for="title">Project Title</label>
                <input type="text" id="title" name="title" 
                    value="<%= projectDetails.title %>" maxlength="150"
                    required />
            </div>

            <div class="form-group">
                <label for="description">Description</label>
                <textarea id="description" name="description" maxlength="500" required>
                    <%= projectDetails.description %>
                </textarea>
            </div>

            <div class="form-group">
                <label for="location">Location</label>
                <input type="text" id="location" name="location" maxlength="255" required
                    value="<%= projectDetails.location %>" />
            </div>

            <div class="form-group">
                <label for="date">Date</label>
                <input type="date" id="date" name="date" required
                    value="<%= projectDetails.date %>" />
            </div>

            <div class="form-group">
            <label for="organizationId">Organization</label>

            <select id="organizationId" name="organizationId" required>
                <% organizations.forEach(organization => { %>
                    <option
                        value="<%= organization.organization_id %>"
                        <%= organization.organization_id === projectDetails.organization_id ? 'selected' : '' %>>
                        <%= organization.name %>
                    </option>
                <% }) %>
            </select>
        </div>

        <a href="/edit-project/<%= projectDetails.project_id %>">
            Edit Project
        </a>


            <button type="submit">Update Project</button>
        </form>

    </main>
    <%- include('partials/footer') %>